# Server
PORT=3000
SESSION_SECRET=change-this-to-a-long-random-string

# Admin account (created automatically on first startup if no admin exists)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme123

# Database path (defaults to ./mkc.db)
DB_PATH=./mkc.db

# Omada controller settings (can also be configured via the admin Settings page)
# OMADA_CONTROLLER_URL=https://192.168.1.1:8043
# OMADA_CONTROLLER_ID=your-omada-cid
# OMADA_SITE_ID=your-site-id
# OMADA_OPERATOR_USERNAME=your-operator-username
# OMADA_OPERATOR_PASSWORD=your-operator-password
